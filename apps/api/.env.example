# API Environment Variables
# Copy to .env and fill in values

NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://plcms:plcms@localhost:5432/plcms

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# PayPal Advanced Checkout
# Create credentials at https://developer.paypal.com/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" for testing, "live" for production
PAYPAL_ENVIRONMENT=sandbox
# Webhook ID from PayPal Developer Dashboard (optional but recommended)
PAYPAL_WEBHOOK_ID=

# Web app base URL (used for PayPal return/cancel URLs)
WEB_BASE_URL=http://localhost:3000

# ShipStation API (for live shipping rate quotes and label purchasing)
# Create API keys at https://app.shipstation.com/settings/api
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=

# SMTP Email (optional – used for shipment notification emails)
# If not set, notifications are logged to console only
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# Telnyx Call Control (pay-per-minute phone calls)
# API key: Telnyx portal > API Keys. Public key: Account Settings > Keys & Credentials
# (used to verify webhook signatures).
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
# ID of the Call Control (Voice API) application whose webhook URL points at
# https://<your-domain>/api/billing/telnyx/webhook
TELNYX_CONNECTION_ID=
# Your Telnyx number in E.164 format, shown as the caller ID on both legs
TELNYX_FROM_NUMBER=
# The number callers dial to reach the hotline, in E.164 format (a toll-free number
# works). It must be assigned to the same Call Control application as above. Leave it
# empty to switch the hotline off: incoming calls are then not answered.
TELNYX_HOTLINE_NUMBER=
# Optional: spoken voice for the "press 1" prompts, in Telnyx's <Provider>.<Voice>
# format. Defaults to AWS.Polly.Joanna.
TELNYX_TTS_VOICE=
