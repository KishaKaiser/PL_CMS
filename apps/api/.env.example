# API Environment Variables
# Copy to .env and fill in values

NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://plcms:plcms@localhost:5432/plcms

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# PayPal Advanced Checkout
# Create credentials at https://developer.paypal.com/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" for testing, "live" for production
PAYPAL_ENVIRONMENT=sandbox
# Webhook ID from PayPal Developer Dashboard (optional but recommended)
PAYPAL_WEBHOOK_ID=

# Web app base URL (used for PayPal return/cancel URLs)
WEB_BASE_URL=http://localhost:3000
