// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum Role {
  ADMIN
  ADVISOR
  EDITOR
  CLIENT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  CANCELLED
  COMPLETED
  REFUNDED
}

enum ShipmentStatus {
  PENDING
  LABEL_PURCHASED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  PAYPAL
  WALLET
  BANK_TRANSFER
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum ProductType {
  PHYSICAL
  DIGITAL
  MINUTE_PACK
}

enum RedirectContentType {
  PAGE
  POST
}

// ──────────────────────────────────────────────
// User
// ──────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String?  @unique
  passwordHash String
  name         String
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  advisorProfile    AdvisorProfile?
  clientProfile     ClientProfile?
  sentMessages      Message[]          @relation("SentMessages")
  receivedMessages  Message[]          @relation("ReceivedMessages")
  broadcastMessages BroadcastMessage[]
  auditLogs         AuditLog[]
  contentRevisions  ContentRevision[]
  builderLayoutsUpdated BuilderLayout[] @relation("BuilderLayoutUpdatedBy")
  builderLayoutVersions BuilderLayoutVersion[] @relation("BuilderLayoutVersionCreatedBy")
  astrologyReports AstrologyReport[]
  builderTemplates BuilderTemplate[] @relation("BuilderTemplateCreatedBy")
  globalComponents GlobalComponent[] @relation("GlobalComponentCreatedBy")
  cmsThemes CmsTheme[] @relation("CmsThemeCreatedBy")
  posts             Post[]
  orders            Order[]
  walletTransactions WalletTransaction[]
  accountAddresses    AccountAddress[]
  savedPaymentMethods SavedPaymentMethod[]
  productReviews ProductReview[]
  postComments   PostComment[]

  @@map("users")
}

// ──────────────────────────────────────────────
// Advisor Profile
// ──────────────────────────────────────────────

model AdvisorProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  displayName   String
  bio           String?
  profileImageUrl String?
  ratePerMinute Decimal  @default(0)
  isOnline      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilitySlots   AvailabilitySchedule[]
  callQueues          CallQueue[]
  callSessionsAsAdvisor CallSession[]        @relation("AdvisorSessions")
  payoutMethods       AdvisorPayoutMethod[]

  @@map("advisor_profiles")
}

// ──────────────────────────────────────────────
// Client Profile
// ──────────────────────────────────────────────

model ClientProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  displayName    String
  balanceMinutes Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  callSessionsAsClient    CallSession[] @relation("ClientSessions")
  queueAssignments        QueueAssignment[]

  @@map("client_profiles")
}

// ──────────────────────────────────────────────
// Availability Schedule
// ──────────────────────────────────────────────

model AvailabilitySchedule {
  id        String   @id @default(cuid())
  advisorId String
  dayOfWeek Int      // 0 = Sunday … 6 = Saturday
  startTime String   // "HH:MM"
  endTime   String   // "HH:MM"
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())

  advisor AdvisorProfile @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@map("availability_schedules")
}

// ──────────────────────────────────────────────
// Call Session
// ──────────────────────────────────────────────

model CallSession {
  id              String    @id @default(cuid())
  advisorId       String
  clientId        String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  billedMinutes   Int?
  status          String    @default("ACTIVE") // ACTIVE | ENDED | FAILED

  advisor AdvisorProfile @relation("AdvisorSessions", fields: [advisorId], references: [id])
  client  ClientProfile  @relation("ClientSessions", fields: [clientId], references: [id])
  walletTransactions WalletTransaction[]

  @@map("call_sessions")
}

// ──────────────────────────────────────────────
// Call Queue
// ──────────────────────────────────────────────

model CallQueue {
  id        String   @id @default(cuid())
  advisorId String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  advisor     AdvisorProfile    @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  assignments QueueAssignment[]

  @@map("call_queues")
}

model QueueAssignment {
  id        String   @id @default(cuid())
  queueId   String
  clientId  String
  position  Int
  joinedAt  DateTime @default(now())
  status    String   @default("WAITING") // WAITING | CALLED | CANCELLED

  queue  CallQueue     @relation(fields: [queueId], references: [id], onDelete: Cascade)
  client ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("queue_assignments")
}

// ──────────────────────────────────────────────
// Messages
// ──────────────────────────────────────────────

model Message {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  sentAt      DateTime  @default(now())
  readAt      DateTime?

  sender    User @relation("SentMessages", fields: [senderId], references: [id])
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id])

  @@index([senderId])
  @@index([recipientId])
  @@index([senderId, recipientId, sentAt])
  @@index([recipientId, readAt])
  @@map("messages")
}

model BroadcastMessage {
  id       String   @id @default(cuid())
  authorId String
  subject  String
  body     String
  sentAt   DateTime @default(now())

  author  User              @relation(fields: [authorId], references: [id])
  targets BroadcastTarget[]

  @@map("broadcast_messages")
}

model BroadcastTarget {
  id          String @id @default(cuid())
  broadcastId String
  targetRole  Role?  // null = all
  userId      String?

  broadcast BroadcastMessage @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@map("broadcast_targets")
}

// ──────────────────────────────────────────────
// Account Dashboard
// ──────────────────────────────────────────────

model AccountAddress {
  id         String   @id @default(cuid())
  userId     String
  label      String
  fullName   String
  phone      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("US")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account_addresses")
}

model SavedPaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  label     String
  provider  String
  brand     String?
  last4     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_payment_methods")
}

model AdvisorPayoutMethod {
  id          String   @id @default(cuid())
  advisorId   String
  label       String
  methodType  String
  accountName String
  details     Json     @default("{}")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  advisor AdvisorProfile @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@index([advisorId])
  @@map("advisor_payout_methods")
}

// ──────────────────────────────────────────────
// CMS – Pages & Posts
// ──────────────────────────────────────────────

model Page {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  metaTitle   String?
  metaDescription String?
  content          String
  featuredImageUrl String?
  featuredMediaId  String?
  builderTemplateId String?
  cmsThemeId        String?
  publishedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  featuredMedia MediaAsset? @relation("PageFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  builderTemplate BuilderTemplate? @relation(fields: [builderTemplateId], references: [id], onDelete: SetNull)
  cmsTheme CmsTheme? @relation(fields: [cmsThemeId], references: [id], onDelete: SetNull)

  @@index([featuredMediaId])
  @@index([builderTemplateId])
  @@index([cmsThemeId])
  @@map("pages")
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  metaTitle   String?
  metaDescription String?
  excerpt     String?
  content          String
  featuredImageUrl String?
  featuredMediaId  String?
  publishedAt      DateTime?
  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author     User       @relation(fields: [authorId], references: [id])
  categories Category[]
  featuredMedia MediaAsset? @relation("PostFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  tags       Tag[]
  comments   PostComment[]

  @@index([featuredMediaId])
  @@map("posts")
}

model MediaAsset {
  id           String   @id @default(cuid())
  storageKey   String   @unique
  originalName String
  title        String
  altText      String?
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  featuredByPages Page[] @relation("PageFeaturedMedia")
  featuredByPosts Post[] @relation("PostFeaturedMedia")
  featuredByProducts Product[] @relation("ProductFeaturedMedia")
  themeAssets ThemeAsset[] @relation("ThemeAssetMedia")

  @@map("media_assets")
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts    Post[]
  products Product[]

  @@map("categories")
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts    Post[]
  products Product[]

  @@map("tags")
}

model SlugRedirect {
  id          String              @id @default(cuid())
  contentType RedirectContentType
  sourceSlug  String
  targetSlug  String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([contentType, sourceSlug])
  @@index([contentType, targetSlug])
  @@map("slug_redirects")
}

model ContentRevision {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  title       String
  content     String
  snapshot    Json
  isAutosave  Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([entityType, entityId])
  @@map("content_revisions")
}

// ──────────────────────────────────────────────
// Visual Builder & Themes
// ──────────────────────────────────────────────

model BuilderLayout {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  draftJson     Json
  publishedJson Json?
  version       Int      @default(1)
  status        String   @default("DRAFT")
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  publishedAt   DateTime?

  updatedBy User? @relation("BuilderLayoutUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  versions  BuilderLayoutVersion[]

  @@unique([entityType, entityId])
  @@index([entityType, entityId])
  @@map("builder_layouts")
}

model BuilderLayoutVersion {
  id        String   @id @default(cuid())
  layoutId  String
  version   Int
  snapshot  Json
  createdById String?
  createdAt DateTime @default(now())

  layout BuilderLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  createdBy User? @relation("BuilderLayoutVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([layoutId, version])
  @@map("builder_layout_versions")
}

model BuilderTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   @default("page")
  schemaJson  Json
  assignmentRules Json @default("{}")
  isGlobal    Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("BuilderTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  pages Page[]

  @@index([category])
  @@map("builder_templates")
}

model BuilderWidget {
  id          String   @id @default(cuid())
  type        String   @unique
  label       String
  category    String   @default("content")
  pluginName  String?
  schemaJson  Json     @default("{}")
  defaultJson Json     @default("{}")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("builder_widgets")
}

model GlobalComponent {
  id          String   @id @default(cuid())
  name        String
  componentType String
  schemaJson  Json
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("GlobalComponentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([componentType])
  @@map("global_components")
}

model CmsTheme {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  version     String   @default("1.0.0")
  description String?
  isActive    Boolean  @default(false)
  globalStyles Json    @default("{}")
  templates   Json     @default("{}")
  components  Json     @default("{}")
  widgetRegistry Json  @default("[]")
  schemaJson  Json     @default("{}")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets    ThemeAsset[]
  pages     Page[]
  createdBy User? @relation("CmsThemeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("cms_themes")
}

model ThemeAsset {
  id        String   @id @default(cuid())
  themeId   String
  assetType String
  path      String
  mimeType  String?
  content   String?
  mediaAssetId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  theme CmsTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation("ThemeAssetMedia", fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([themeId])
  @@map("theme_assets")
}

// ──────────────────────────────────────────────
// Settings
// ──────────────────────────────────────────────

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ──────────────────────────────────────────────
// Modules
// ──────────────────────────────────────────────

model Module {
  id        String   @id @default(cuid())
  name      String   @unique
  version   String
  enabled   Boolean  @default(false)
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("modules")
}

// ──────────────────────────────────────────────
// Forms
// ──────────────────────────────────────────────

model CmsForm {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  description    String?
  type           String   @default("CONTACT")
  status         String   @default("DRAFT")
  fields         Json     @default("[]")
  settings       Json     @default("{}")
  successMessage String   @default("Thank you. Your submission has been received.")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submissions CmsFormSubmission[]

  @@index([type, status])
  @@map("cms_forms")
}

model CmsFormSubmission {
  id        String   @id @default(cuid())
  formId    String
  data      Json
  status    String   @default("NEW")
  userId    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  form CmsForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
  @@index([status])
  @@map("cms_form_submissions")
}

// ──────────────────────────────────────────────
// Sliders
// ──────────────────────────────────────────────

model CmsSlider {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  status      String   @default("DRAFT")
  slides      Json     @default("[]")
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@map("cms_sliders")
}

// ──────────────────────────────────────────────
// Audit Log
// ──────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@map("audit_logs")
}

// ──────────────────────────────────────────────
// E-commerce – Products
// ──────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String
  type        ProductType @default(DIGITAL)
  description String?
  shortDescription String?
  price       Decimal
  regularPrice Decimal?
  salePrice    Decimal?
  saleStartsAt DateTime?
  saleEndsAt   DateTime?
  currency    String   @default("USD")
  isActive    Boolean  @default(true)
  minutesPack Int      @default(0)
  weightOz     Decimal?
  lengthIn     Decimal?
  widthIn      Decimal?
  heightIn     Decimal?
  trackStock   Boolean  @default(false)
  stockQuantity Int     @default(0)
  stockStatus  String   @default("IN_STOCK")
  imageUrl     String?
  featuredMediaId String?
  digitalDelivery String @default("NONE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
  variants   ProductVariant[]
  featuredMedia MediaAsset? @relation("ProductFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  categories Category[]
  tags       Tag[]
  reviews    ProductReview[]
  astrologyReports AstrologyReport[]

  @@index([featuredMediaId])
  @@map("products")
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@map("product_reviews")
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_comments")
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  color         String
  sku           String   @unique
  priceOverride Decimal?
  imageUrl      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Inventory {
  id        String   @id @default(cuid())
  variantId String   @unique
  onHand    Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

// ──────────────────────────────────────────────
// E-commerce – Orders
// ──────────────────────────────────────────────

model Order {
  id               String      @id @default(cuid())
  userId           String
  status           OrderStatus @default(PENDING)
  totalAmount      Decimal
  currency         String      @default("USD")
  paypalOrderId    String?     @unique
  payerEmail       String?
  shippingCarrier  String?
  shippingService  String?
  shippingAmount   Decimal?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  payments          Payment[]
  walletTransactions WalletTransaction[]
  shippingAddress   OrderAddress?
  shipments         Shipment[]
  astrologyReports  AstrologyReport[]

  @@index([userId])
  @@map("orders")
}

// ──────────────────────────────────────────────
// Shipping Address (attached to Order)
// ──────────────────────────────────────────────

model OrderAddress {
  id         String @id @default(cuid())
  orderId    String @unique
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String @default("US")
  email      String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_addresses")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  quantity  Int      @default(1)
  unitPrice Decimal
  createdAt DateTime @default(now())

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  astrologyReport AstrologyReport?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model AstrologyReport {
  id           String   @id @default(cuid())
  userId       String
  orderId      String
  orderItemId  String   @unique
  productId    String
  status       String   @default("PENDING")
  formData     Json
  reportUrl    String?
  reportText   String?
  fileName     String?
  errorMessage String?
  submittedAt  DateTime @default(now())
  generatedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([orderId])
  @@index([productId])
  @@map("astrology_reports")
}

// ──────────────────────────────────────────────
// E-commerce – Payments
// ──────────────────────────────────────────────

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  amount        Decimal
  currency      String        @default("USD")
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  paypalOrderId String?
  paypalCaptureId String?      @unique
  paypalPayerId String?
  transactionId String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  walletTransactions WalletTransaction[]

  @@index([paypalOrderId])
  @@map("payments")
}

// ──────────────────────────────────────────────
// Wallet Transactions
// ──────────────────────────────────────────────

model WalletTransaction {
  id          String                @id @default(cuid())
  userId      String
  orderId     String?
  paymentId   String?
  callSessionId String?
  type        WalletTransactionType
  amount      Decimal
  currency    String                @default("USD")
  minutesDelta Int?
  description String?
  createdAt   DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  callSession CallSession? @relation(fields: [callSessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([paymentId])
  @@index([callSessionId])
  @@map("wallet_transactions")
}

// ──────────────────────────────────────────────
// Fulfillment – Shipments
// ──────────────────────────────────────────────

model Shipment {
  id                    String         @id @default(cuid())
  orderId               String
  shipstationShipmentId String?
  carrier               String?
  service               String?
  trackingNumber        String?
  labelUrl              String?
  status                ShipmentStatus @default(PENDING)
  shippedAt             DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("shipments")
}
