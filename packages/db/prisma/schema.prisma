// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum Role {
  ADMIN
  ADVISOR
  EDITOR
  CLIENT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  CANCELLED
  COMPLETED
  REFUNDED
}

enum ShipmentStatus {
  PENDING
  LABEL_PURCHASED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  PAYPAL
  WALLET
  BANK_TRANSFER
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum ProductType {
  PHYSICAL
  DIGITAL
  MINUTE_PACK
}

enum RedirectContentType {
  PAGE
  POST
}

// ──────────────────────────────────────────────
// User
// ──────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String?  @unique
  passwordHash String
  name         String
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  advisorProfile    AdvisorProfile?
  clientProfile     ClientProfile?
  sentMessages      Message[]          @relation("SentMessages")
  receivedMessages  Message[]          @relation("ReceivedMessages")
  broadcastMessages BroadcastMessage[]
  contactLists      ContactList[]
  freeMinutesGiven  FreeMinuteGrant[] @relation("FreeMinutesGivenBy")
  auditLogs         AuditLog[]
  contentRevisions  ContentRevision[]
  builderLayoutsUpdated BuilderLayout[] @relation("BuilderLayoutUpdatedBy")
  builderLayoutVersions BuilderLayoutVersion[] @relation("BuilderLayoutVersionCreatedBy")
  astrologyReports AstrologyReport[]
  astrologyCharts  AstrologyChart[]
  builderTemplates BuilderTemplate[] @relation("BuilderTemplateCreatedBy")
  globalComponents GlobalComponent[] @relation("GlobalComponentCreatedBy")
  cmsThemes CmsTheme[] @relation("CmsThemeCreatedBy")
  posts             Post[]
  orders            Order[]
  walletTransactions WalletTransaction[]
  accountAddresses    AccountAddress[]
  savedPaymentMethods SavedPaymentMethod[]
  productReviews ProductReview[]
  advisorReviews AdvisorReview[]
  favoriteAdvisors FavoriteAdvisor[]
  paypalWallet   PaypalWallet?
  paypalWalletSetups PaypalWalletSetup[]
  walletTopUps   WalletTopUp[]
  postComments   PostComment[]

  @@map("users")
}

// ──────────────────────────────────────────────
// Advisor Profile
// ──────────────────────────────────────────────

model AdvisorProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  displayName   String
  bio           String?
  profileImageUrl String?
  ratePerMinute Decimal  @default(0)
  isOnline      Boolean  @default(false)
  // Short code that identifies this advisor on the phone (e.g. "1001"), such
  // as when a caller keys it into the dial-in hotline. It is only a label the
  // system uses to know who to call; calls are placed to phoneNumber.
  sipExtension  String?
  // E.164 number of the advisor's own phone. When a client asks to speak to
  // this advisor, the system dials this number and bridges the client to it.
  phoneNumber   String?
  // URL-friendly name for the advisor's public profile page (/advisors/<slug>).
  // Assigned from the display name the first time it is needed and then kept
  // stable, so shared links keep working if the advisor changes their name.
  slug          String?  @unique
  // Whether the queue auto-dialer should call through this advisor's
  // callback queue. Kept separate from isOnline: an advisor can be online
  // for direct/scheduled calls without the queue auto-dialer running.
  queueCallingEnabled Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilitySlots   AvailabilitySchedule[]
  callQueues          CallQueue[]
  callSessionsAsAdvisor CallSession[]        @relation("AdvisorSessions")
  payoutMethods       AdvisorPayoutMethod[]
  appointments        Appointment[]          @relation("AdvisorAppointments")
  reviews             AdvisorReview[]
  favoritedBy         FavoriteAdvisor[]
  freeMinuteGrants    FreeMinuteGrant[]

  @@map("advisor_profiles")
}

// ──────────────────────────────────────────────
// Client Profile
// ──────────────────────────────────────────────

model ClientProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  displayName    String
  // Dollar-balance wallet, in cents. Call billing charges the connected
  // advisor's real ratePerMinute from this balance.
  balanceCents   Int      @default(0)
  // E.164 number (e.g. "+15551234567") the system dials to connect this
  // client to an advisor.
  phoneNumber    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  callSessionsAsClient    CallSession[] @relation("ClientSessions")
  queueAssignments        QueueAssignment[]
  appointments            Appointment[] @relation("ClientAppointments")
  freeMinuteGrants        FreeMinuteGrant[]

  @@map("client_profiles")
}

// ──────────────────────────────────────────────
// Availability Schedule
// ──────────────────────────────────────────────

model AvailabilitySchedule {
  id        String   @id @default(cuid())
  advisorId String
  dayOfWeek Int      // 0 = Sunday … 6 = Saturday
  startTime String   // "HH:MM"
  endTime   String   // "HH:MM"
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())

  advisor AdvisorProfile @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@map("availability_schedules")
}

// ──────────────────────────────────────────────
// Call Session
// ──────────────────────────────────────────────

model CallSession {
  id              String    @id @default(cuid())
  advisorId       String
  clientId        String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  billedMinutes   Int?
  billedAmountCents Int?
  // Telnyx Call Control IDs for the two legs of a bridged call. Needed to hang
  // the legs up via Telnyx's REST API on low balance or when the client ends
  // the session, since neither happens inside a webhook.
  clientCallControlId  String?
  advisorCallControlId String?
  // When the client and advisor were bridged. Talk time is measured from here.
  connectedAt     DateTime?
  // When the next debit is due. Right after connecting it is the end of the
  // free period (when billing starts); after that the billing cron advances it
  // a minute at a time as each tick is charged.
  nextBillAt      DateTime?
  // When both parties were told the balance is about to run out; cleared each
  // time a minute is charged so a later shortage can warn again.
  lowBalanceWarnedAt DateTime?
  // PENDING_CONNECTION (dialing the client) → AWAITING_CLIENT (client must press 1)
  // → DIALING_ADVISOR (advisor must press 1) → CONNECTED (bridged, free period)
  // → BILLING_ACTIVE, then ENDED* (ENDED, ENDED_BY_USER, ENDED_LOW_BALANCE,
  // ENDED_NOT_CONNECTED).
  status          String    @default("ACTIVE")
  // How the call started: DIRECT (Call Now) or HOTLINE. Appointment and queue calls are told
  // apart by their own links to this session.
  source          String    @default("DIRECT")
  // Set when the client said no to the in-call offer to add money, so they are not asked again on this call.
  topUpDeclinedAt DateTime?
  // How many of this call's minutes were covered by free minutes instead of the wallet.
  freeMinutesUsed Int       @default(0)

  advisor AdvisorProfile @relation("AdvisorSessions", fields: [advisorId], references: [id])
  client  ClientProfile  @relation("ClientSessions", fields: [clientId], references: [id])
  walletTransactions WalletTransaction[]
  appointment Appointment?
  queueAssignment QueueAssignment?

  @@index([startedAt])

  @@map("call_sessions")
}

// ──────────────────────────────────────────────
// Call Queue
// ──────────────────────────────────────────────

model CallQueue {
  id        String   @id @default(cuid())
  advisorId String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  advisor     AdvisorProfile    @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  assignments QueueAssignment[]

  @@map("call_queues")
}

model QueueAssignment {
  id             String   @id @default(cuid())
  queueId        String
  clientId       String
  position       Int
  joinedAt       DateTime @default(now())
  // How long the client chose to wait before giving up.
  maxWaitMinutes Int      @default(30)
  // Computed at join time as joinedAt + maxWaitMinutes; a sweep expires any
  // still-WAITING assignment past this time.
  expiresAt      DateTime
  // WAITING → CALLING (the callback is being placed) → COMPLETED | MISSED.
  // Or CANCELLED (the client left) / EXPIRED (waited too long, the advisor went
  // offline or stopped the queue, or the wallet ran short).
  status         String   @default("WAITING")
  // Why a spot ended without a call, shown to the client.
  note           String?
  // The callback placed for this spot; set when the system starts dialing.
  callSessionId  String?  @unique
  // How many calls have been placed for this turn. A call that does not connect is
  // redialed once, shortly after, before the line moves on to the next client.
  attempts       Int      @default(0)
  // When the redial is due; empty means the spot is simply waiting its turn.
  nextAttemptAt  DateTime?
  updatedAt      DateTime @default(now()) @updatedAt

  queue       CallQueue     @relation(fields: [queueId], references: [id], onDelete: Cascade)
  client      ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  callSession CallSession?  @relation(fields: [callSessionId], references: [id], onDelete: SetNull)

  @@index([queueId, status])
  @@index([clientId, status])
  @@map("queue_assignments")
}

// ──────────────────────────────────────────────
// Scheduled Appointments
// ──────────────────────────────────────────────

model Appointment {
  id            String   @id @default(cuid())
  advisorId     String
  clientId      String
  scheduledAt   DateTime
  // PENDING (awaiting the advisor) → ACCEPTED → IN_PROGRESS (the call is being placed)
  // → COMPLETED | MISSED. Or DECLINED, CANCELLED, EXPIRED (the advisor never responded).
  status        String   @default("PENDING")
  // Why an appointment was missed or expired, shown to both parties.
  note          String?
  // How many calls have been placed for this appointment. If the first one does not
  // connect the system redials once; a second miss marks the appointment missed.
  attempts      Int      @default(0)
  // When the redial is due after a miss. Empty means the scheduled time is the next try.
  nextAttemptAt DateTime?
  // The call placed for this appointment; set when the system starts dialing.
  callSessionId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  advisor     AdvisorProfile @relation("AdvisorAppointments", fields: [advisorId], references: [id], onDelete: Cascade)
  client      ClientProfile  @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  callSession CallSession?   @relation(fields: [callSessionId], references: [id], onDelete: SetNull)

  @@index([advisorId, status])
  @@index([clientId, status])
  @@map("appointments")
}

// ──────────────────────────────────────────────
// Messages
// ──────────────────────────────────────────────

model Message {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  // Messages work like email: a subject, and replies share the thread of the message they answer.
  // Older messages have neither, so a message with no thread is a thread of its own.
  subject     String?
  threadId    String?
  body        String
  sentAt      DateTime  @default(now())
  readAt      DateTime?
  // Where the message sits for each side: ACTIVE (inbox or sent), TRASH, or PURGED (deleted for good, for that side only).
  senderFolder    String @default("ACTIVE")
  recipientFolder String @default("ACTIVE")

  sender    User @relation("SentMessages", fields: [senderId], references: [id])
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id])

  @@index([senderId])
  @@index([recipientId])
  @@index([senderId, recipientId, sentAt])
  @@index([recipientId, readAt])
  @@index([threadId])
  @@map("messages")
}

model BroadcastMessage {
  id       String   @id @default(cuid())
  authorId String
  subject  String
  body     String
  sentAt   DateTime @default(now())
  // How many people it went to.
  recipientCount Int   @default(0)

  author  User              @relation(fields: [authorId], references: [id])
  targets BroadcastTarget[]

  @@map("broadcast_messages")
}

model BroadcastTarget {
  id          String @id @default(cuid())
  broadcastId String
  targetRole  Role?  // null = all
  userId      String?

  broadcast BroadcastMessage @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@map("broadcast_targets")
}

// ──────────────────────────────────────────────
// Account Dashboard
// ──────────────────────────────────────────────

model AccountAddress {
  id         String   @id @default(cuid())
  userId     String
  label      String
  fullName   String
  phone      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("US")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account_addresses")
}

model SavedPaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  label     String
  provider  String
  brand     String?
  last4     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_payment_methods")
}

model AdvisorPayoutMethod {
  id          String   @id @default(cuid())
  advisorId   String
  label       String
  methodType  String
  accountName String
  details     Json     @default("{}")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  advisor AdvisorProfile @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@index([advisorId])
  @@map("advisor_payout_methods")
}

// ──────────────────────────────────────────────
// CMS – Pages & Posts
// ──────────────────────────────────────────────

model Page {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  metaTitle   String?
  metaDescription String?
  content          String
  featuredImageUrl String?
  featuredMediaId  String?
  builderTemplateId String?
  cmsThemeId        String?
  publishedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  featuredMedia MediaAsset? @relation("PageFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  builderTemplate BuilderTemplate? @relation(fields: [builderTemplateId], references: [id], onDelete: SetNull)
  cmsTheme CmsTheme? @relation(fields: [cmsThemeId], references: [id], onDelete: SetNull)

  @@index([featuredMediaId])
  @@index([builderTemplateId])
  @@index([cmsThemeId])
  @@map("pages")
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  metaTitle   String?
  metaDescription String?
  excerpt     String?
  content          String
  featuredImageUrl String?
  featuredMediaId  String?
  publishedAt      DateTime?
  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author     User       @relation(fields: [authorId], references: [id])
  categories Category[]
  featuredMedia MediaAsset? @relation("PostFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  tags       Tag[]
  comments   PostComment[]

  @@index([featuredMediaId])
  @@map("posts")
}

model MediaAsset {
  id           String   @id @default(cuid())
  storageKey   String   @unique
  originalName String
  title        String
  altText      String?
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  featuredByPages Page[] @relation("PageFeaturedMedia")
  featuredByPosts Post[] @relation("PostFeaturedMedia")
  featuredByProducts Product[] @relation("ProductFeaturedMedia")
  themeAssets ThemeAsset[] @relation("ThemeAssetMedia")

  @@map("media_assets")
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts    Post[]
  products Product[]

  @@map("categories")
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts    Post[]
  products Product[]

  @@map("tags")
}

model SlugRedirect {
  id          String              @id @default(cuid())
  contentType RedirectContentType
  sourceSlug  String
  targetSlug  String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([contentType, sourceSlug])
  @@index([contentType, targetSlug])
  @@map("slug_redirects")
}

model ContentRevision {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  title       String
  content     String
  snapshot    Json
  isAutosave  Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([entityType, entityId])
  @@map("content_revisions")
}

// ──────────────────────────────────────────────
// Visual Builder & Themes
// ──────────────────────────────────────────────

model BuilderLayout {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  draftJson     Json
  publishedJson Json?
  version       Int      @default(1)
  status        String   @default("DRAFT")
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  publishedAt   DateTime?

  updatedBy User? @relation("BuilderLayoutUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  versions  BuilderLayoutVersion[]

  @@unique([entityType, entityId])
  @@index([entityType, entityId])
  @@map("builder_layouts")
}

model BuilderLayoutVersion {
  id        String   @id @default(cuid())
  layoutId  String
  version   Int
  snapshot  Json
  createdById String?
  createdAt DateTime @default(now())

  layout BuilderLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  createdBy User? @relation("BuilderLayoutVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([layoutId, version])
  @@map("builder_layout_versions")
}

model BuilderTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   @default("page")
  schemaJson  Json
  assignmentRules Json @default("{}")
  isGlobal    Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("BuilderTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  pages Page[]

  @@index([category])
  @@map("builder_templates")
}

model BuilderWidget {
  id          String   @id @default(cuid())
  type        String   @unique
  label       String
  category    String   @default("content")
  pluginName  String?
  schemaJson  Json     @default("{}")
  defaultJson Json     @default("{}")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("builder_widgets")
}

model GlobalComponent {
  id          String   @id @default(cuid())
  name        String
  componentType String
  schemaJson  Json
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("GlobalComponentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([componentType])
  @@map("global_components")
}

model CmsTheme {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  version     String   @default("1.0.0")
  description String?
  isActive    Boolean  @default(false)
  globalStyles Json    @default("{}")
  templates   Json     @default("{}")
  components  Json     @default("{}")
  widgetRegistry Json  @default("[]")
  schemaJson  Json     @default("{}")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets    ThemeAsset[]
  pages     Page[]
  createdBy User? @relation("CmsThemeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("cms_themes")
}

model ThemeAsset {
  id        String   @id @default(cuid())
  themeId   String
  assetType String
  path      String
  mimeType  String?
  content   String?
  mediaAssetId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  theme CmsTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation("ThemeAssetMedia", fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([themeId])
  @@map("theme_assets")
}

// ──────────────────────────────────────────────
// Settings
// ──────────────────────────────────────────────

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ──────────────────────────────────────────────
// Modules
// ──────────────────────────────────────────────

model Module {
  id        String   @id @default(cuid())
  name      String   @unique
  version   String
  enabled   Boolean  @default(false)
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("modules")
}

// ──────────────────────────────────────────────
// Forms
// ──────────────────────────────────────────────

model CmsForm {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  description    String?
  type           String   @default("CONTACT")
  status         String   @default("DRAFT")
  fields         Json     @default("[]")
  settings       Json     @default("{}")
  successMessage String   @default("Thank you. Your submission has been received.")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submissions CmsFormSubmission[]

  @@index([type, status])
  @@map("cms_forms")
}

model CmsFormSubmission {
  id        String   @id @default(cuid())
  formId    String
  data      Json
  status    String   @default("NEW")
  userId    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  form CmsForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
  @@index([status])
  @@map("cms_form_submissions")
}

// ──────────────────────────────────────────────
// Sliders
// ──────────────────────────────────────────────

model CmsSlider {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  status      String   @default("DRAFT")
  slides      Json     @default("[]")
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@map("cms_sliders")
}

// ──────────────────────────────────────────────
// Audit Log
// ──────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@map("audit_logs")
}

// ──────────────────────────────────────────────
// E-commerce – Products
// ──────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String
  type        ProductType @default(DIGITAL)
  description String?
  shortDescription String?
  price       Decimal
  regularPrice Decimal?
  salePrice    Decimal?
  saleStartsAt DateTime?
  saleEndsAt   DateTime?
  currency    String   @default("USD")
  isActive    Boolean  @default(true)
  minutesPack Int      @default(0)
  weightOz     Decimal?
  lengthIn     Decimal?
  widthIn      Decimal?
  heightIn     Decimal?
  trackStock   Boolean  @default(false)
  stockQuantity Int     @default(0)
  stockStatus  String   @default("IN_STOCK")
  imageUrl     String?
  featuredMediaId String?
  digitalDelivery String @default("NONE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
  variants   ProductVariant[]
  featuredMedia MediaAsset? @relation("ProductFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  categories Category[]
  tags       Tag[]
  reviews    ProductReview[]
  astrologyReports AstrologyReport[]

  @@index([featuredMediaId])
  @@map("products")
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@map("product_reviews")
}

// A client's star rating and comment for an advisor, shown on the advisor's public
// profile. Only clients who have actually spoken with the advisor can leave one,
// and each client has a single review per advisor that they can edit.
// Recorded versions of the lines callers hear on the phone. Kept in the database so they
// survive redeploys; Telnyx plays them from a public address.
model PhonePromptAudio {
  key       String   @id
  fileToken String   @unique
  format    String   // mp3 | wav
  fileName  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("phone_prompt_audio")
}

// A client's saved PayPal wallet (a PayPal Vault payment token), charged only when they choose to
// add money during a call.
model PaypalWallet {
  id         String   @id @default(cuid())
  userId     String   @unique
  vaultId    String   @unique
  payerEmail String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("paypal_wallets")
}

// A wallet connection the client has started on PayPal's site but not finished yet.
model PaypalWalletSetup {
  id           String   @id @default(cuid())
  userId       String
  setupTokenId String   @unique
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("paypal_wallet_setups")
}

// Every attempt to add money from a saved PayPal wallet. Used for the daily limit and as a record of
// what was charged.
model WalletTopUp {
  id              String   @id @default(cuid())
  userId          String
  amountCents     Int
  // PENDING (charging) → COMPLETED | FAILED
  status          String   @default("PENDING")
  source          String   @default("CALL")
  callSessionId   String?
  paypalOrderId   String?
  paypalCaptureId String?  @unique
  failureReason   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("wallet_top_ups")
}

// An advisor a client has saved to their favourites list.
model FavoriteAdvisor {
  id        String   @id @default(cuid())
  userId    String
  advisorId String
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  advisor AdvisorProfile @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@unique([userId, advisorId])
  @@index([userId, createdAt])
  @@map("favorite_advisors")
}

// An advisor's own lists of the clients they have spoken with ("Monday callers"), used to message a group at once.
model ContactList {
  id            String   @id @default(cuid())
  advisorUserId String
  name          String
  createdAt     DateTime @default(now())

  advisor User                @relation(fields: [advisorUserId], references: [id], onDelete: Cascade)
  members ContactListMember[]

  @@unique([advisorUserId, name])
  @@map("contact_lists")
}

model ContactListMember {
  id           String   @id @default(cuid())
  listId       String
  clientUserId String
  createdAt    DateTime @default(now())

  list ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, clientUserId])
  @@index([clientUserId])
  @@map("contact_list_members")
}

// Free call minutes given to a client. advisorId set = usable only with that advisor (an advisor's gift);
// null = usable with any advisor (admin gifts and promotions). Used before the wallet is charged.
model FreeMinuteGrant {
  id              String    @id @default(cuid())
  clientId        String
  advisorId       String?
  minutes         Int
  remaining       Int
  // ADVISOR, ADMIN or PROMO (the welcome promotion for new clients).
  source          String
  grantedByUserId String?
  note            String?
  // Makes a promotion idempotent: one grant per client per promoKey.
  promoKey        String?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  client    ClientProfile   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  advisor   AdvisorProfile? @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  grantedBy User?           @relation("FreeMinutesGivenBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@unique([clientId, promoKey])
  @@index([clientId, remaining])
  @@index([grantedByUserId, createdAt])
  @@map("free_minute_grants")
}

model AdvisorReview {
  id        String   @id @default(cuid())
  advisorId String
  userId    String
  rating    Int      // 1 to 5
  comment   String?
  // Set by an admin to hide the review from the public profile and the advisor's
  // average. The review itself is kept so it can be shown again.
  hiddenAt     DateTime?
  hiddenReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  advisor AdvisorProfile @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([advisorId, userId])
  @@index([advisorId, createdAt])
  @@index([advisorId, hiddenAt])
  @@index([userId])
  @@map("advisor_reviews")
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_comments")
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  color         String
  sku           String   @unique
  priceOverride Decimal?
  imageUrl      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Inventory {
  id        String   @id @default(cuid())
  variantId String   @unique
  onHand    Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

// ──────────────────────────────────────────────
// E-commerce – Orders
// ──────────────────────────────────────────────

model Order {
  id               String      @id @default(cuid())
  userId           String
  status           OrderStatus @default(PENDING)
  totalAmount      Decimal
  currency         String      @default("USD")
  paypalOrderId    String?     @unique
  payerEmail       String?
  shippingCarrier  String?
  shippingService  String?
  shippingAmount   Decimal?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  payments          Payment[]
  walletTransactions WalletTransaction[]
  shippingAddress   OrderAddress?
  shipments         Shipment[]
  astrologyReports  AstrologyReport[]

  @@index([userId])
  @@map("orders")
}

// ──────────────────────────────────────────────
// Shipping Address (attached to Order)
// ──────────────────────────────────────────────

model OrderAddress {
  id         String @id @default(cuid())
  orderId    String @unique
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String @default("US")
  email      String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_addresses")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  quantity  Int      @default(1)
  unitPrice Decimal
  createdAt DateTime @default(now())

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  astrologyReport AstrologyReport?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model AstrologyReport {
  id           String   @id @default(cuid())
  userId       String
  orderId      String
  orderItemId  String   @unique
  productId    String
  status       String   @default("PENDING")
  formData     Json
  reportUrl    String?
  reportText   String?
  fileName     String?
  errorMessage String?
  submittedAt  DateTime @default(now())
  generatedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([orderId])
  @@index([productId])
  @@map("astrology_reports")
}

// Ad-hoc, admin-generated astrology charts (Chart Library) — natal previews,
// synastry, karmic, family, transits, electional, and rectification. Not tied
// to an order; kept separate from AstrologyReport, which is purchase-driven.
model AstrologyChart {
  id           String    @id @default(cuid())
  createdById  String
  reportType   String
  title        String
  inputData    Json
  chartData    Json
  resultData   Json?
  aiText       String?
  status       String    @default("READY")
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([reportType])
  @@map("astrology_charts")
}

// General (non-natal) horoscope content — one row per zodiac sign per
// calendar month, generated automatically. Not tied to a user; this is
// public site content shown on the /horoscopes page.
model Horoscope {
  id          String   @id @default(cuid())
  sign        String
  year        Int
  month       Int
  overview    String
  career      String
  money       String
  love        String
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sign, year, month])
  @@index([year, month])
  @@map("horoscopes")
}

// ──────────────────────────────────────────────
// E-commerce – Payments
// ──────────────────────────────────────────────

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  amount        Decimal
  currency      String        @default("USD")
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  paypalOrderId String?
  paypalCaptureId String?      @unique
  paypalPayerId String?
  transactionId String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  walletTransactions WalletTransaction[]

  @@index([paypalOrderId])
  @@map("payments")
}

// ──────────────────────────────────────────────
// Wallet Transactions
// ──────────────────────────────────────────────

model WalletTransaction {
  id          String                @id @default(cuid())
  userId      String
  orderId     String?
  paymentId   String?
  callSessionId String?
  type        WalletTransactionType
  amount      Decimal
  currency    String                @default("USD")
  minutesDelta Int?
  description String?
  createdAt   DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  callSession CallSession? @relation(fields: [callSessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([paymentId])
  @@index([callSessionId])
  @@map("wallet_transactions")
}

// ──────────────────────────────────────────────
// Fulfillment – Shipments
// ──────────────────────────────────────────────

model Shipment {
  id                    String         @id @default(cuid())
  orderId               String
  shipstationShipmentId String?
  carrier               String?
  service               String?
  trackingNumber        String?
  labelUrl              String?
  status                ShipmentStatus @default(PENDING)
  shippedAt             DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("shipments")
}
